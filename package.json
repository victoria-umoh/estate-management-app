{
  "name": "estate-management-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/next-with-env.mjs dev",
    "build": "next build && node scripts/check-bundle-budget.mjs",
    "start": "node scripts/next-with-env.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:wait": "tsx --import ./scripts/load-env.mjs scripts/wait-for-db.ts",
    "db:indexes": "tsx --import ./scripts/load-env.mjs scripts/sync-indexes.ts",
    "seed": "tsx --import ./scripts/load-env.mjs scripts/seed.ts",
    "seed:reset": "tsx --import ./scripts/load-env.mjs scripts/seed.ts --reset",
    "worker": "tsx --import ./scripts/load-env.mjs scripts/worker.ts",
    "job:overstay": "tsx --import ./scripts/load-env.mjs scripts/run-job.ts overstay-sweep",
    "job:billing": "tsx --import ./scripts/load-env.mjs scripts/run-job.ts billing-run",
    "bench:gate": "tsx --import ./scripts/load-env.mjs scripts/bench-gate.ts",
    "openapi": "tsx --import ./scripts/load-env.mjs scripts/generate-openapi.ts",
    "keys:generate": "tsx --import ./scripts/load-env.mjs scripts/generate-keys.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "job:sla": "tsx --import ./scripts/load-env.mjs scripts/run-job.ts sla-sweep",
    "seed:ui": "tsx --import ./scripts/load-env.mjs scripts/seed-ui-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hookform/resolvers": "^3.9.1",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-three/drei": "^9.120.0",
    "@react-three/fiber": "^8.17.10",
    "@sentry/nextjs": "^10.75.0",
    "@tanstack/react-query": "^5.62.0",
    "@upstash/redis": "^1.34.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.0",
    "nanoid": "^5.0.9",
    "newrelic": "^14.5.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.4",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "recharts": "^2.14.1",
    "resend": "^4.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.171.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@newrelic/fn-inspect",
      "@newrelic/native-metrics",
      "@sentry/cli",
      "esbuild",
      "mongodb-memory-server",
      "msgpackr-extract",
      "protobufjs",
      "unrs-resolver"
    ]
  }
}
