# =============================================================================
#  ESTATE & COMMUNITY MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION
# =============================================================================
#  Copy to `.env.local` for development:  cp .env.example .env.local
#  Generate all secret values at once:    pnpm keys:generate
#
#  Every value below is validated at boot by src/core/config. The process
#  refuses to start rather than run with a missing or malformed secret, so a
#  misconfigured deploy fails loudly instead of silently running insecurely.
#
#  NEVER commit a filled-in copy of this file. Only `.env.example` is tracked.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Runtime mode. One of: development | test | production
NODE_ENV=development

# Port the server listens on. Read by `pnpm dev` and `pnpm start`.
#
# Next binds its port before it loads this file, so the value is passed through
# as a CLI flag by scripts/next-with-env.mjs rather than read by Next directly.
# A PORT already set in your shell takes precedence over this.
PORT=3000

# Interface to bind. Leave as localhost for development. Use 0.0.0.0 to accept
# connections from other machines — inside Docker, or when testing the gate
# scanner from a phone or tablet on the same network.
HOST=localhost

# Public origin of this deployment, no trailing slash. Used to build absolute
# links in emails, QR payloads, visitor passes and Paystack callback URLs.
# Must be HTTPS in production — cookies are issued with `Secure` there.
APP_URL=http://localhost:3000

# Human-readable platform name. Appears in emails, SMS, PDFs and page titles.
APP_NAME="EstateOS"

# Support address shown to residents in transactional messages.
APP_SUPPORT_EMAIL=support@example.com

# Comma-separated origins allowed to call /api/v1 with credentials.
# Add your native mobile app's origin here when it ships. Leave empty to allow
# same-origin only, which is the correct setting for a web-only deploy.
CORS_ALLOWED_ORIGINS=

# Deployment target. Selects the default adapter set (see INTEGRATIONS below).
#   vercel     -> Upstash cache, cron-route queue, S3/R2 storage
#   self-hosted -> ioredis cache, BullMQ queue, MinIO storage
RUNTIME_TARGET=self-hosted


# -----------------------------------------------------------------------------
# DATABASE (MongoDB)
# -----------------------------------------------------------------------------

# Connection string. A REPLICA SET IS REQUIRED — the platform uses multi-document
# transactions for every financial and critical state change, and standalone
# mongod does not support them. `docker compose up` provisions a single-node
# replica set locally; MongoDB Atlas is a replica set by default.
# Note: docker compose publishes Mongo on 27018 to avoid clashing with a local
# mongod on the default port. `directConnection=true` is intentional and must
# NOT be combined with `replicaSet=` — drivers reject that pairing. Transactions
# still work, because we connect straight to the replica set primary.
MONGODB_URI=mongodb://localhost:27018/estate_management?directConnection=true

# Database name. Overrides any database present in MONGODB_URI when set.
MONGODB_DB_NAME=estate_management

# Connection pool bounds. Raise maxPoolSize for high gate throughput; keep it
# low (5-10) on serverless where each instance holds its own pool.
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# Abort any query exceeding this many milliseconds. Protects the gate path from
# being blocked behind an accidental collection scan.
MONGODB_MAX_TIME_MS=10000


# -----------------------------------------------------------------------------
# AUTHENTICATION & CRYPTOGRAPHY
# -----------------------------------------------------------------------------
#  Generate every secret in this section with `pnpm keys:generate`.
#  Rotating any of them invalidates the tokens or data derived from it — read
#  docs/SECURITY.md before rotating in production.

# Signing key for short-lived access JWTs. 64 hex chars (32 bytes) minimum.
# Rotating this logs everyone out, which is the intended emergency response to
# a suspected token leak.
JWT_ACCESS_SECRET=

# Signing key for refresh tokens. MUST differ from JWT_ACCESS_SECRET so that a
# leaked access key cannot be used to mint long-lived sessions.
JWT_REFRESH_SECRET=

# Access token lifetime. Keep this short — a stolen access token is only useful
# for this long. Refresh rotation covers the user-facing session length.
JWT_ACCESS_TTL=15m

# Refresh token lifetime, i.e. how long a user stays logged in without
# re-entering a password. Each use rotates the token; reuse of a rotated token
# is treated as theft and revokes the entire session family.
JWT_REFRESH_TTL=30d

# AES-256-GCM key encrypting sensitive identity fields at rest (NIN, document
# numbers, bank details). Exactly 64 hex chars (32 bytes).
# LOSING THIS KEY MAKES ENCRYPTED DATA PERMANENTLY UNREADABLE. Back it up in a
# secret manager, never in this file in production.
ENCRYPTION_KEY=

# Key version written alongside every ciphertext so keys can be rotated without
# a full re-encryption. Increment when introducing a new ENCRYPTION_KEY.
ENCRYPTION_KEY_VERSION=1

# HMAC-SHA256 key for blind indexes. Lets us enforce "one account per NIN" and
# detect duplicate identities WITHOUT storing or being able to read the NIN.
# Rotating this requires rebuilding every blind index. 64 hex chars.
ENCRYPTION_BLIND_INDEX_KEY=

# HMAC key signing QR payloads on resident IDs, vehicle tags and visitor passes.
# Signed, opaque and rotatable — a photographed expired QR will not verify.
QR_SIGNING_SECRET=

# Failed logins before an account is temporarily locked, and the lock duration.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m

# One-time password settings for phone verification and step-up auth.
# Short TTL and few attempts are deliberate: OTP is a brute-forceable secret.
OTP_LENGTH=6
OTP_TTL=10m
OTP_MAX_ATTEMPTS=3

# Issuer label shown in authenticator apps (Google Authenticator, 1Password)
# when a user enables TOTP two-factor authentication.
TOTP_ISSUER=EstateOS

# argon2id password hashing cost. Defaults follow OWASP guidance. Raise
# ARGON2_MEMORY_COST on beefier hardware; do not lower these without reason.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1


# -----------------------------------------------------------------------------
# CACHE & RATE LIMITING (Redis)
# -----------------------------------------------------------------------------

# Adapter: ioredis | upstash | memory
#   ioredis  — self-hosted Redis, also powers BullMQ
#   upstash  — serverless HTTP Redis, for Vercel
#   memory   — in-process only. DEVELOPMENT AND TESTS ONLY: rate limits and the
#              gate cache would not be shared across instances in production.
CACHE_DRIVER=ioredis

# Used when CACHE_DRIVER=ioredis
REDIS_URL=redis://localhost:6381

# Used when CACHE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global API rate limit per authenticated user per minute. Sensitive routes
# (login, OTP, payment init) declare their own tighter limits in code.
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Rate limit per IP per minute for unauthenticated routes (login, register).
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20

# How long the gate fast-path caches a verified credential. Keep this low:
# it is the window during which a just-revoked pass could still scan valid.
GATE_CACHE_TTL_SECONDS=30


# -----------------------------------------------------------------------------
# BACKGROUND JOBS
# -----------------------------------------------------------------------------

# Adapter: bullmq | cron-route | inline
#   bullmq     — real worker process (`pnpm worker`), retries and backoff
#   cron-route — scheduled HTTP routes, for Vercel Cron
#   inline     — run jobs synchronously. TESTS ONLY.
QUEUE_DRIVER=bullmq

# Shared secret required by /api/cron/* routes when QUEUE_DRIVER=cron-route.
# Without it anyone could trigger billing runs. Generated by `pnpm keys:generate`.
CRON_SECRET=

# Minutes past a visitor pass's expected departure before the visitor is flagged
# as overstaying. Estates can override this in their own settings; this is the
# platform default applied to new estates.
VISITOR_OVERSTAY_GRACE_MINUTES=60


# -----------------------------------------------------------------------------
# FILE STORAGE (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# -----------------------------------------------------------------------------
#  Documents (NIN slips, leases, vehicle papers, incident photos) are PRIVATE.
#  Nothing is ever served from a public bucket URL — access goes through
#  short-lived presigned URLs issued only after a permission check.

# Adapter: s3 | local
#   local — filesystem storage under ./tmp/uploads. DEVELOPMENT ONLY.
STORAGE_DRIVER=s3

S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=estate-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Required for MinIO and most S3-compatible providers; false for real AWS S3.
S3_FORCE_PATH_STYLE=true

# Lifetime of presigned download URLs. Short, because the URL itself is a
# bearer credential for that one file.
S3_PRESIGN_EXPIRY_SECONDS=300

# Upload constraints, enforced server-side as well as in the browser.
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Optional ClamAV daemon for malware scanning of uploads. Leave empty to skip
# scanning (uploads are still type- and size-validated and stored privately).
CLAMAV_HOST=
CLAMAV_PORT=3310


# -----------------------------------------------------------------------------
# PAYMENTS (Paystack)
# -----------------------------------------------------------------------------
#  Two distinct money flows share one integration:
#   1. Residents paying their estate's dues  -> settles to the ESTATE's subaccount
#   2. Estates paying platform subscriptions -> settles to the PLATFORM account
#  Each estate's subaccount code is stored per-estate in the database, not here.

# Platform Paystack keys. Use test keys (sk_test_… / pk_test_…) in development.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Paystack webhook signature verification. Every webhook body is HMAC-SHA512
# verified against the RAW request body before it is parsed or trusted.
# A payment is NEVER marked successful on the browser's say-so.
# Paystack signs with your secret key; set this only if you use a distinct one.
PAYSTACK_WEBHOOK_SECRET=

# Where Paystack returns the resident after checkout.
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/callback

# Platform commission (percent) taken from resident dues collected through an
# estate's subaccount. Set to 0 to take no cut.
PAYSTACK_PLATFORM_COMMISSION_PERCENT=0

# Default currency. Paystack supports NGN, GHS, ZAR, KES, USD.
DEFAULT_CURRENCY=NGN


# -----------------------------------------------------------------------------
# NOTIFICATIONS — EMAIL
# -----------------------------------------------------------------------------

# Adapter: resend | sendgrid | smtp | console
#   console — prints messages to stdout instead of sending. DEVELOPMENT ONLY.
EMAIL_DRIVER=console

EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="EstateOS"

# Used when EMAIL_DRIVER=resend
RESEND_API_KEY=

# Used when EMAIL_DRIVER=sendgrid
SENDGRID_API_KEY=

# Used when EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


# -----------------------------------------------------------------------------
# NOTIFICATIONS — SMS
# -----------------------------------------------------------------------------
#  SMS carries OTPs and emergency alerts, so delivery failures are surfaced
#  loudly rather than swallowed.

# Adapter: termii | twilio | console
SMS_DRIVER=console

# Registered sender ID shown on the recipient's handset.
SMS_SENDER_ID=EstateOS

# Used when SMS_DRIVER=termii
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com

# Termii route. One of: dnd | generic | whatsapp
#   dnd     — reaches numbers on the carrier Do-Not-Disturb list, which most
#             Nigerian numbers are on by default. Costs more per message.
#   generic — cheaper, but DND numbers silently receive nothing. The message is
#             reported as accepted and never arrives, which for an emergency
#             alert is the worst possible failure.
# Leave as dnd unless you have measured that your recipients are not on DND.
TERMII_CHANNEL=dnd

# Used when SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# NOTIFICATIONS — DELIVERY BEHAVIOUR
# -----------------------------------------------------------------------------
#  These govern the notification service itself rather than any one provider.
#  The in-app record is always written; email and SMS are best-effort copies
#  dispatched through the job queue. Emergency and security notifications ignore
#  resident channel preferences entirely — that rule lives in code, not here,
#  so it cannot be switched off by an environment variable.

# How long an outbound email or SMS HTTP call may take before it is aborted.
# Bounds the queue worker: without it, one hanging provider holds a worker slot
# indefinitely and the backlog behind it never drains. Missing: defaults to
# 15000 (15 seconds).
NOTIFICATION_PROVIDER_TIMEOUT_MS=15000

# How long in-app notification records are kept before housekeeping soft-deletes
# them. The underlying events (invoices, incidents, gate movements) live in their
# own collections and are unaffected — this only trims the resident's feed.
# Missing: defaults to 180 days.
NOTIFICATION_RETENTION_DAYS=180

# Maximum residents a single announcement publish will notify. A very large
# estate would otherwise write tens of thousands of records inside one request.
# Publishing past this limit truncates the audience and logs a warning rather
# than failing, so the announcement still reaches most of the estate.
# Missing: defaults to 5000.
NOTIFICATION_ANNOUNCEMENT_FANOUT_LIMIT=5000


# -----------------------------------------------------------------------------
# IDENTITY VERIFICATION (NIN)
# -----------------------------------------------------------------------------

# Adapter: mock | dojah | prembly
#   mock — deterministic offline verifier for development, demos and tests.
#          Accepts any 11-digit NIN; NINs ending in 0 simulate a failed match
#          so the rejection path stays exercised. NEVER use in production.
IDENTITY_DRIVER=mock

# Used when IDENTITY_DRIVER=dojah
DOJAH_APP_ID=
DOJAH_API_KEY=
DOJAH_BASE_URL=https://api.dojah.io

# Used when IDENTITY_DRIVER=prembly
PREMBLY_APP_ID=
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com

# Require a successful NIN check before an account can be approved. Turning
# this off lets admins approve residents on documents alone.
IDENTITY_REQUIRE_NIN_VERIFICATION=true


# -----------------------------------------------------------------------------
# SAAS SUBSCRIPTION & TRIALS
# -----------------------------------------------------------------------------

# Free trial length for a newly registered estate, and the plan it trials on.
TRIAL_DURATION_DAYS=30
TRIAL_PLAN_CODE=professional

# Maximum units an estate may register while still on trial.
TRIAL_MAX_UNITS=100

# After a subscription lapses: days of read-only access before suspension,
# then days the data is retained before it becomes eligible for deletion.
SUBSCRIPTION_GRACE_PERIOD_DAYS=14
SUBSCRIPTION_DATA_RETENTION_DAYS=90

# Allow anyone to register a new estate from the marketing site. Set to false
# to run a single-estate or invite-only deployment.
ALLOW_PUBLIC_ESTATE_SIGNUP=true


# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Pretty-print logs for humans. Leave false in production so logs stay
# machine-parseable JSON.
LOG_PRETTY=true

# --- Sentry: error tracking and session replay -------------------------------
# Leave SENTRY_DSN empty to disable Sentry entirely; the SDK is not initialised
# and no network calls are made. Safe default for local development.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Fraction of transactions sampled for performance tracing (0.0 - 1.0).
# 1.0 is fine in development; lower it in production to control cost and volume.
SENTRY_TRACES_SAMPLE_RATE=1.0

# Fraction of sessions recorded for replay, and of errored sessions. Replay can
# capture screen content, so it is OFF by default: this app displays NIN,
# addresses and minors' records. Enable only with masking configured.
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# Required only at build time to upload source maps for readable stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- New Relic: APM and infrastructure metrics --------------------------------
# Leave NEW_RELIC_LICENSE_KEY empty to disable the agent completely.
# New Relic instruments Node at require-time, so it is loaded via
# `--require newrelic` in the server start script rather than imported.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=EstateOS
NEW_RELIC_ENABLED=false

# Log forwarding ships application logs to New Relic alongside traces.
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true

# Distributed tracing links New Relic spans to Sentry transactions and to our
# own correlation IDs, so one request can be followed across all three.
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# High-security mode strips request parameters and raises redaction. Recommended
# ON in production: request bodies here contain NIN, phone numbers and payment
# references that must never leave the platform in telemetry.
NEW_RELIC_HIGH_SECURITY=false

# --- OpenTelemetry (vendor-neutral tracing) ----------------------------------
# Leave the endpoint empty to disable. Can run alongside Sentry and New Relic.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=estate-management-app


# -----------------------------------------------------------------------------
# SEED & DEMO DATA
# -----------------------------------------------------------------------------
#  `pnpm seed` creates a demo estate with one account per role, all sharing the
#  password below. The seeder REFUSES TO RUN when NODE_ENV=production.

SEED_DEMO_PASSWORD=DemoPass123!
SEED_ESTATE_NAME="Palm Grove Estate"
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
#  Platform-wide kill switches. Per-estate feature access is decided by the
#  estate's subscription plan, not by these.

# Render the Three.js scenes on marketing, ID card and estate map surfaces.
# Disable to serve a lightweight static fallback everywhere.
FEATURE_3D_ENABLED=true

# Expose the geolocation capture seam on movement and emergency records.
FEATURE_GEOLOCATION_ENABLED=false

# Expose outbound webhooks and API keys for device/IoT integrations.
FEATURE_DEVICE_INTEGRATIONS_ENABLED=false
